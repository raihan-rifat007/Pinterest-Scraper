}
.pm-badge i { color: var(--text-muted); font-size: 1rem; }
.pm-badge-val { font-weight: 800; color: var(--red); font-family: var(--mono); font-variant-numeric: tabular-nums; }
.pm-badge-lbl { color: var(--text-muted); font-size: .72rem; font-weight: 600; text-transform: uppercase; letter-spacing: .04em; }
.pm-board-row { display: flex; align-items: center; gap: 8px; font-size: .85rem; font-weight: 600; color: var(--text-muted); flex-wrap: wrap; }
.pm-board-link { color: var(--red); text-decoration: none; font-weight: 700; }
.pm-board-link:hover { text-decoration: underline; }
.pm-colors-wrap { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
.pm-section-label {
  font-size: .7rem; font-weight: 700;
  text-transform: uppercase; letter-spacing: .08em;
  color: var(--text-dim);
  display: inline-flex; align-items: center; gap: 5px;
  white-space: nowrap;
}
.pm-colors { display: flex; gap: 8px; flex-wrap: wrap; }
.color-chip {
  width: 36px; height: 36px;
  border-radius: 10px; cursor: pointer;
  border: 2px solid var(--border-strong);
  box-shadow: 0 2px 8px rgba(0,0,0,.15);
  transition: transform .25s var(--ease-spring);
  position: relative;
  touch-action: manipulation;
}
.color-chip:hover { transform: scale(1.22) translateY(-2px); box-shadow: 0 8px 20px rgba(0,0,0,.25); z-index: 1; }
.color-chip:active { transform: scale(1.35); }
.pm-actions { margin-top: auto; padding-top: 12px; display: flex; gap: 10px; flex-wrap: wrap; }

.toast-container {
  position: fixed;
  bottom: calc(24px + var(--safe-bottom));
  right: max(24px, var(--safe-right));
  z-index: 500;
  display: flex; flex-direction: column;
  gap: 10px;
  pointer-events: none;
  max-width: min(380px, calc(100vw - 32px));
}
.toast {
  display: flex; align-items: center; gap: 12px;
  padding: 14px 18px;
  background: var(--bg-elevated);
  border: 1px solid var(--border-strong);
  border-radius: var(--radius);
  box-shadow: var(--shadow-lg);
  font-size: .88rem; font-weight: 500;
  pointer-events: auto;
  animation: toastIn .35s var(--ease-spring);
  min-width: 280px;
}
@keyframes toastIn { from { transform: translateX(120%); opacity: 0; } to { transform: translateX(0); opacity: 1; } }
.toast.out { animation: toastOut .3s var(--ease) forwards; }
@keyframes toastOut { to { transform: translateX(120%); opacity: 0; } }
.toast i:first-child { font-size: 1.15rem; flex-shrink: 0; }
.toast.success i:first-child { color: var(--green); }
.toast.error i:first-child { color: var(--red); }
.toast.info i:first-child { color: var(--blue); }
.toast-msg { flex: 1; color: var(--text-soft); }

.scroll-sentinel { height: 10px; }

::-webkit-scrollbar { width: 12px; height: 12px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: var(--surface-2); border-radius: 10px; border: 3px solid transparent; background-clip: padding-box; }
::-webkit-scrollbar-thumb:hover { background-color: var(--text-dim); background-clip: padding-box; border-width: 2px; }
* { scrollbar-width: thin; scrollbar-color: var(--surface-2) transparent; }

@keyframes fadeUp { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }

@media (max-width: 900px) {
  .pin-modal-grid { grid-template-columns: 1fr; }
  .pin-modal-imgwrap { min-height: 45vh; max-height: 55vh; }
  .pin-modal-imgwrap img, .pm-video { max-height: 55vh; }
}

@media (max-width: 760px) {
  :root { --topbar-h: auto; }
  .topbar {
    flex-wrap: wrap;
    padding-top: max(10px, var(--safe-top));
    padding-bottom: 10px;
    padding-left: max(14px, var(--safe-left));
    padding-right: max(14px, var(--safe-right));
    gap: 10px;
  }
  .logo { padding: 2px; }
  .logo-badge { width: 34px; height: 34px; font-size: 1.05rem; }
  .logo-name, .logo-tag { display: none; }
  .search-box {
    order: 3;
    flex-basis: 100%;
    max-width: 100%;
    margin: 0;
  }
  .topbar-actions { margin-left: auto; }
  .icon-btn { width: 40px; height: 40px; font-size: 1.1rem; }
  main {
    padding: 16px max(14px, var(--safe-left)) calc(60px + var(--safe-bottom)) max(14px, var(--safe-right));
  }
  .hero { padding: 20px 8px 24px; }
  .hero h1 { font-size: 1.9rem; }
  .hero p { font-size: .92rem; }
  .hero-suggestions { gap: 6px; }
  .suggestion-pill { padding: 8px 14px; font-size: .8rem; min-height: 36px; }
  .masonry { columns: 2 150px; column-gap: 10px; }
  .pin-card { margin-bottom: 10px; border-radius: var(--radius); }
  .pin-overlay { opacity: 0; }
  .pin-card .pin-overlay { opacity: 0; }
  .toolbar { gap: 8px; }
  .tool-btn span { display: none; }
  .tool-btn { padding: 0 12px; }
  .segmented { flex: 1; min-width: 0; }
  .segmented .tab { padding: 9px 14px; font-size: .82rem; flex: 1; justify-content: center; }
  .segmented .tab span:not(.badge) { display: none; }
  .segmented .tab .badge { display: inline-flex; }
  .toolbar-group { width: 100%; justify-content: space-between; }
  .pin-modal {
    padding: 0;
    padding-top: var(--safe-top);
    padding-bottom: var(--safe-bottom);
  }
  .pin-modal::before { background: rgba(0,0,0,.92); }
  .pin-modal-box {
    max-width: 100%;
    max-height: 100%;
    height: 100%;
    border-radius: 0;
    border: none;
  }
  .pin-modal-grid { max-height: calc(100dvh - 66px - var(--safe-top) - var(--safe-bottom)); }
  .pin-modal-imgwrap { min-height: 42vh; }
  .pin-modal-imgwrap img, .pm-video { max-height: 42vh; }
  .nav-btn { display: none; }
  .pm-topbar { padding: 12px 14px; }
  .pm-topbar .btn.ghost span { display: none; }
  .pm-top-left, .pm-top-right { gap: 6px; }
  .pin-modal-info { padding: 20px 18px calc(24px + var(--safe-bottom)); gap: 16px; }
  .pm-title { font-size: 1.15rem; }
  .pm-creator-link { display: none; }
  .stats-grid { grid-template-columns: repeat(2, 1fr); }
  .stat-card { padding: 12px; gap: 10px; }
  .stat-icon { width: 34px; height: 34px; font-size: 1rem; }
  .stat-num { font-size: 1.1rem; }
  .stat-lbl { font-size: .62rem; }
  .footer-inner { flex-direction: column; text-align: center; }
  .footer-links { justify-content: center; }
  .cp-panel { max-width: 100%; max-height: 85vh; }
  .command-palette { padding-top: 8vh; }
  .toast-container {
    left: max(12px, var(--safe-left));
    right: max(12px, var(--safe-right));
    bottom: calc(12px + var(--safe-bottom));
  }
  .toast { min-width: 0; }
  .drawer {
    width: 100vw;
    max-width: 100vw;
    border-left: none;
  }
  .drawer-body { padding: 20px 18px calc(40px + var(--safe-bottom)); }
  .drawer-head { padding: 18px 18px; }
  .progress-card, .stats-card, .chart-card { padding: 18px 16px; }
  .progress-head-right { gap: 10px; }
  .progress-pct { font-size: 1.1rem; }
  .selection-bar {
    padding: 10px 10px 10px 18px;
    gap: 10px;
    bottom: calc(16px + var(--safe-bottom));
  }
  .video-badge {
    width: 52px;
    height: 52px;
    font-size: 1.5rem;
  }
}
@media (max-width: 420px) {
  .masonry { columns: 2; column-gap: 8px; }
  .pin-card { margin-bottom: 8px; }
  .hero h1 { font-size: 1.7rem; }
  .stats-grid { grid-template-columns: 1fr 1fr; }
}
@media (hover: none) {
  .pin-overlay { opacity: 1 !important; pointer-events: auto !important; background: linear-gradient(to top, rgba(0,0,0,.92) 0%, rgba(0,0,0,.5) 22%, transparent 42%); }
  .pin-meta { opacity: 1 !important; transform: none !important; }
  .pin-save { opacity: 1 !important; transform: none !important; }
  .pin-save { padding: 8px 14px; font-size: .76rem; }
  .pin-meta .title { font-size: .8rem; }
  .pin-meta .stats, .pin-meta .links { display: none; }
  .color-chip:hover { transform: none; }
}
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: .01ms !important;
    scroll-behavior: auto !important;
  }
}