:root {
  --red: #E60023;
  --red-hover: #C4001E;
  --red-soft: rgba(230, 0, 35, 0.10);
  --bg: #FCFCFD;
  --bg-elevated: #FFFFFF;
  --bg-sunken: #F7F7F9;
  --surface: #F1F1F4;
  --surface-2: #E8E8EC;
  --border: rgba(0, 0, 0, 0.06);
  --border-strong: rgba(0, 0, 0, 0.10);
  --text: #0A0A0B;
  --text-soft: #1F1F23;
  --text-muted: #6E6E78;
  --text-dim: #A0A0AA;
  --green: #10B981;
  --blue: #3B82F6;
  --amber: #F59E0B;
  --radius-xs: 8px;
  --radius-sm: 12px;
  --radius: 16px;
  --radius-lg: 22px;
  --radius-xl: 28px;
  --radius-full: 999px;
  --shadow-xs: 0 1px 2px rgba(0,0,0,.04);
  --shadow-sm: 0 2px 8px rgba(0,0,0,.04), 0 1px 2px rgba(0,0,0,.04);
  --shadow: 0 8px 24px rgba(0,0,0,.06), 0 2px 6px rgba(0,0,0,.04);
  --shadow-lg: 0 20px 60px rgba(0,0,0,.12), 0 4px 12px rgba(0,0,0,.06);
  --shadow-xl: 0 40px 120px rgba(0,0,0,.20), 0 8px 24px rgba(0,0,0,.08);
  --shadow-red: 0 12px 32px rgba(230, 0, 35, 0.25);
  --ease: cubic-bezier(0.16, 1, 0.3, 1);
  --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
  --font: 'Inter', -apple-system, 'Segoe UI', Roboto, sans-serif;
  --mono: 'JetBrains Mono', 'SF Mono', monospace;
  --topbar-h: 68px;
  --safe-top: env(safe-area-inset-top, 0px);
  --safe-bottom: env(safe-area-inset-bottom, 0px);
  --safe-left: env(safe-area-inset-left, 0px);
  --safe-right: env(safe-area-inset-right, 0px);
}
body[data-theme="dark"] {
  --bg: #08080A;
  --bg-elevated: #0F0F12;
  --bg-sunken: #050506;
  --surface: #17171B;
  --surface-2: #202026;
  --border: rgba(255, 255, 255, 0.06);
  --border-strong: rgba(255, 255, 255, 0.12);
  --text: #F7F7F9;
  --text-soft: #E5E5EA;
  --text-muted: #8E8E99;
  --text-dim: #57575F;
  --shadow-sm: 0 2px 8px rgba(0,0,0,.3);
  --shadow: 0 8px 24px rgba(0,0,0,.4);
  --shadow-lg: 0 20px 60px rgba(0,0,0,.6);
  --shadow-xl: 0 40px 120px rgba(0,0,0,.8);
}
* { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }
html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
body {
  font-family: var(--font);
  background: var(--bg);
  color: var(--text);
  min-height: 100vh;
  min-height: 100dvh;
  display: flex;
  flex-direction: column;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  letter-spacing: -0.011em;
  overscroll-behavior-y: none;
}
body::before {
  content: '';
  position: fixed; inset: 0;
  background:
    radial-gradient(ellipse 800px 600px at 20% -10%, rgba(230, 0, 35, 0.06), transparent 50%),
    radial-gradient(ellipse 800px 600px at 100% 0%, rgba(139, 92, 246, 0.05), transparent 50%);
  pointer-events: none;
  z-index: 0;
}
body[data-theme="dark"]::before {
  background:
    radial-gradient(ellipse 800px 600px at 20% -10%, rgba(230, 0, 35, 0.10), transparent 50%),
    radial-gradient(ellipse 800px 600px at 100% 0%, rgba(139, 92, 246, 0.08), transparent 50%);
}
.hidden { display: none !important; }
a { color: inherit; }
button, input, select, textarea { font-family: inherit; }
input, textarea, select { font-size: 16px; }
::selection { background: var(--red); color: #fff; }

.topbar {
  position: sticky; top: 0; z-index: 100;
  min-height: var(--topbar-h);
  padding-top: var(--safe-top);
  padding-left: max(20px, var(--safe-left));
  padding-right: max(20px, var(--safe-right));
  display: flex; align-items: center; gap: 16px;
  background: var(--bg);
  border-bottom: 1px solid var(--border);
}
.logo {
  display: flex; align-items: center; gap: 10px;
  text-decoration: none; flex-shrink: 0;
  padding: 4px; border-radius: 999px;
  transition: background .15s;
  min-height: 44px;
}
.logo:hover { background: var(--surface); }
.logo-badge {
  width: 36px; height: 36px; border-radius: 50%;
  background: linear-gradient(135deg, #FF1E3D 0%, var(--red) 50%, #8B0020 100%);
  color: #fff; display: grid; place-items: center;
  font-size: 1.15rem;
  box-shadow: var(--shadow-red), inset 0 1px 0 rgba(255,255,255,.25);
  transition: transform .3s var(--ease-spring);
}
.logo:hover .logo-badge { transform: rotate(-12deg) scale(1.08); }
.logo-name { font-weight: 800; font-size: 1rem; letter-spacing: -0.03em; }
.logo-tag {
  font-size: .6rem; font-weight: 700;
  padding: 3px 7px; border-radius: 999px;
  background: var(--red); color: #fff;
  letter-spacing: .04em;
}
.search-box {
  flex: 1; max-width: 620px; margin: 0 auto;
  min-height: 42px;
  display: flex; align-items: center; gap: 10px;
  padding: 0 10px 0 16px;
  background: var(--surface);
  border: 1px solid transparent;
  border-radius: var(--radius-full);
  position: relative;
  transition: background .2s var(--ease), border-color .2s var(--ease), box-shadow .2s var(--ease);
}
.search-box:focus-within {
  background: var(--bg-elevated);
  border-color: var(--red);
  box-shadow: 0 0 0 3px var(--red-soft);
}
.search-box > i { color: var(--text-muted); font-size: 1rem; flex-shrink: 0; }
.search-box input {
  flex: 1; min-width: 0;
  border: none; outline: none; background: transparent;
  font: 500 .9rem var(--font);
  color: var(--text);
  height: 40px;
}
.search-box input::placeholder { color: var(--text-dim); }
.search-clear {
  width: 24px; height: 24px; border-radius: 50%;
  border: none; background: var(--surface-2);
  color: var(--text-muted); cursor: pointer;
  display: none; place-items: center;
  font-size: .75rem;
  flex-shrink: 0;
  transition: background .15s;
}
.search-clear:hover { background: var(--text-dim); color: var(--bg-elevated); }
.search-box.has-value .search-clear { display: grid; }
.search-box:focus-within .kbd-hint { display: none; }
.kbd-hint {
  display: inline-flex; align-items: center;
  padding: 3px 8px;
  font-family: var(--mono); font-size: .7rem; font-weight: 600;
  background: var(--bg-elevated);
  border: 1px solid var(--border-strong);
  border-radius: 6px;
  color: var(--text-muted);
  line-height: 1;
  min-height: 20px;
  cursor: pointer;
}
.topbar-actions { display: flex; gap: 4px; flex-shrink: 0; align-items: center; }
.icon-btn {
  width: 42px; height: 42px; border-radius: 11px; border: none;
  background: transparent; color: var(--text-muted); cursor: pointer;
  font-size: 1.15rem;
  display: grid; place-items: center;
  transition: background .15s var(--ease), color .15s var(--ease), transform .15s var(--ease);
  position: relative;
}
.icon-btn:hover { background: var(--surface); color: var(--text); }
.icon-btn:active { transform: scale(.92); }
.icon-btn[data-active="true"] { color: var(--red); background: var(--red-soft); }
.icon-btn.settings-btn {
  background: var(--red);
  color: #fff;
  box-shadow: 0 4px 14px rgba(230,0,35,.28);
}
.icon-btn.settings-btn:hover {
  background: var(--red-hover);
  color: #fff;
  box-shadow: 0 6px 20px rgba(230,0,35,.4);
  transform: translateY(-1px);
}
.status-dot {
  position: absolute; top: 8px; right: 8px;
  width: 8px; height: 8px; border-radius: 50%;
  background: var(--text-dim);
  box-shadow: 0 0 0 2px var(--bg);
  transition: background .3s;
}
.status-dot.online { background: var(--green); }
.status-dot.offline { background: #EF4444; }

main {
  flex: 1;
  width: 100%;
  max-width: 1480px;
  margin: 0 auto;
  padding: 32px max(24px, var(--safe-left)) calc(80px + var(--safe-bottom)) max(24px, var(--safe-right));
  position: relative; z-index: 1;
}
.hero { text-align: center; padding: 40px 20px 32px; animation: fadeUp .6s var(--ease) both; }
.hero-eyebrow {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 6px 14px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 999px;
  font-size: .78rem; font-weight: 600;
  color: var(--text-muted);
  margin-bottom: 20px;
  transition: color .3s;
}
.hero-eyebrow .dot {
  width: 6px; height: 6px; border-radius: 50%;
  background: var(--text-dim);
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--text-dim) 20%, transparent);
  transition: background .3s, box-shadow .3s;
}
.hero-eyebrow.online .dot {
  background: var(--green);
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--green) 20%, transparent);
  animation: pulse-dot 2s ease-in-out infinite;
}
.hero-eyebrow.offline .dot {
  background: #EF4444;
  box-shadow: 0 0 0 3px color-mix(in srgb, #EF4444 20%, transparent);
}
@keyframes pulse-dot { 0%, 100% { opacity: 1; } 50% { opacity: .5; } }
.hero h1 {
  font-size: clamp(2rem, 4.5vw, 3.2rem);
  font-weight: 900;
  letter-spacing: -0.045em;
  line-height: 1.05;
  margin-bottom: 16px;
  background: linear-gradient(135deg, var(--text) 30%, var(--text-muted));
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}
.hero h1 .accent {
  background: linear-gradient(135deg, var(--red), #FF4D6A);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}
.hero p {
  font-size: 1.02rem;
  color: var(--text-muted);
  max-width: 520px;
  margin: 0 auto 28px;
  line-height: 1.6;
}
.hero-suggestions {
  display: flex; flex-wrap: wrap; gap: 8px;
  justify-content: center;
  max-width: 720px; margin: 0 auto;
}
.suggestion-pill {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 10px 16px;
  background: var(--bg-elevated);
  border: 1px solid var(--border);
  border-radius: 999px;
  font: 600 .84rem var(--font);
  color: var(--text-soft);
  cursor: pointer;
  transition: border-color .2s var(--ease), color .2s var(--ease), transform .2s var(--ease), box-shadow .2s var(--ease);
  box-shadow: var(--shadow-xs);
  min-height: 40px;
}
.suggestion-pill:hover {
  border-color: var(--red);
  color: var(--red);
  transform: translateY(-1px);
  box-shadow: 0 6px 16px rgba(230, 0, 35, 0.10);
}
.suggestion-pill:active { transform: translateY(0) scale(.97); }
.suggestion-pill i { color: var(--red); font-size: .95rem; }

.toolbar { display: flex; align-items: center; gap: 12px; margin-bottom: 24px; flex-wrap: wrap; }
.segmented {
  display: inline-flex;
  padding: 4px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-full);
  position: relative;
}
.segmented .tab {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 10px 20px; border-radius: var(--radius-full);
  font: 600 .86rem var(--font);
  background: transparent;
  color: var(--text-muted);
  border: none; cursor: pointer;
  position: relative; z-index: 1;
  transition: color .25s var(--ease);
  min-height: 40px;
}
.segmented .tab:hover { color: var(--text); }
.segmented .tab.active { color: var(--bg-elevated); }
body[data-theme="dark"] .segmented .tab.active { color: var(--bg); }
.segmented .tab-indicator {
  position: absolute;
  top: 4px; left: 4px;
  height: calc(100% - 8px);
  border-radius: var(--radius-full);
  background: var(--text);
  box-shadow: 0 2px 8px rgba(0,0,0,.15);
  transition: transform .35s var(--ease-spring), width .35s var(--ease-spring);
  z-index: 0;
}
.tab .badge {
  background: rgba(255,255,255,.2);
  color: currentColor;
  padding: 2px 8px; border-radius: 999px;
  font-size: .7rem; font-weight: 800;
  min-width: 20px; text-align: center;
  transition: background .2s, color .2s;
}
.tab:not(.active) .badge { background: var(--surface-2); color: var(--text-muted); }
.tab.active .badge { background: var(--red); color: #fff; }
.toolbar-spacer { flex: 1; }
.toolbar-group { display: flex; gap: 6px; align-items: center; }
.tool-btn {
  height: 42px; padding: 0 14px;
  display: inline-flex; align-items: center; gap: 8px;
  background: var(--bg-elevated);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  font: 600 .82rem var(--font);
  color: var(--text-soft);
  cursor: pointer;
  transition: background .15s var(--ease), border-color .15s var(--ease), color .15s var(--ease);
}
.tool-btn:hover { background: var(--surface); border-color: var(--border-strong); }
.tool-btn i { color: var(--text-muted); font-size: .95rem; }
.tool-btn.active { background: var(--red-soft); color: var(--red); border-color: transparent; }
.tool-btn.active i { color: var(--red); }
.density-toggle {
  display: inline-flex;
  background: var(--bg-elevated);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 3px;
  gap: 2px;
}
.density-toggle button {
  width: 38px; height: 34px;
  border: none; background: transparent;
  border-radius: 9px;
  color: var(--text-muted); cursor: pointer;
  font-size: 1rem;
  display: grid; place-items: center;
  transition: background .15s var(--ease), color .15s var(--ease);
  touch-action: manipulation;
}
.density-toggle button:hover { color: var(--text); background: var(--surface); }
.density-toggle button.active { background: var(--text); color: var(--bg-elevated); }

.progress-card, .stats-card, .chart-card {
  background: var(--bg-elevated);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 24px 26px;
  margin-bottom: 22px;
  box-shadow: var(--shadow-sm);
  animation: fadeUp .4s var(--ease) both;
}
.progress-head { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: 18px; flex-wrap: wrap; }
.progress-head-left { display: flex; align-items: center; gap: 12px; min-width: 0; flex: 1; }
.progress-head-left .spinner {
  width: 20px; height: 20px;
  border: 2.5px solid var(--surface-2);
  border-top-color: var(--red);
  border-radius: 50%;
  animation: spin .7s linear infinite;
  flex-shrink: 0;
}
@keyframes spin { to { transform: rotate(360deg); } }
#progress-title { font-weight: 700; font-size: .98rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.progress-head-right { display: flex; align-items: center; gap: 14px; flex-shrink: 0; }
.progress-pct {
  font-family: var(--mono);
  font-weight: 700; font-size: 1.35rem;
  color: var(--red);
  font-variant-numeric: tabular-nums;
}
.phase-chips { display: flex; gap: 6px; margin-bottom: 14px; flex-wrap: wrap; }
.phase-chip {
  display: inline-flex; align-items: center; gap: 6px;
  font-size: .72rem; font-weight: 700;
  text-transform: uppercase; letter-spacing: .06em;
  padding: 6px 14px; border-radius: 999px;
  background: var(--surface); color: var(--text-muted);
  transition: background .3s var(--ease), color .3s var(--ease), box-shadow .3s var(--ease);
}
.phase-chip.active { background: var(--red); color: #fff; box-shadow: var(--shadow-red); }
.phase-chip.active::before {
  content: ''; width: 6px; height: 6px; border-radius: 50%;
  background: #fff;
  animation: pulse-dot 1s ease-in-out infinite;
}
.phase-chip.done { background: var(--surface-2); color: var(--text); }
.phase-chip.done::after { content: ' ✓'; }
.bar { height: 8px; border-radius: 999px; background: var(--surface-2); overflow: hidden; margin-bottom: 12px; position: relative; }
.bar-fill {
  height: 100%; width: 0%; border-radius: 999px;
  background: linear-gradient(90deg, var(--red), #FF4D6A, #FF7A8F);
  background-size: 200% 100%;
  animation: gradient-shift 3s ease infinite;
  transition: width .45s var(--ease);
  box-shadow: 0 0 12px rgba(230, 0, 35, 0.4);
}
@keyframes gradient-shift { 0%, 100% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } }
.bar-fill.indeterminate {
  width: 40% !important;
  animation: slide 1.4s ease-in-out infinite alternate, gradient-shift 3s ease infinite;
}
@keyframes slide { from { margin-left: 0; } to { margin-left: 60%; } }
.progress-meta {
  font-size: .82rem; color: var(--text-muted);
  font-variant-numeric: tabular-nums;
  font-family: var(--mono);
  font-weight: 500;
}
.stats-header { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 20px; flex-wrap: wrap; }
.stats-title { display: flex; align-items: center; gap: 10px; font-weight: 700; font-size: .95rem; }
.stats-title i { color: var(--red); font-size: 1.15rem; }
.stats-query {
  font-family: var(--mono);
  font-size: .78rem; font-weight: 600;
  padding: 5px 12px; border-radius: 999px;
  background: var(--surface); color: var(--text-muted);
  max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; }
.stat-card {
  display: flex; align-items: center; gap: 14px;
  padding: 16px;
  background: var(--bg-sunken);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  transition: transform .2s var(--ease), box-shadow .2s var(--ease);
}
.stat-card:hover { transform: translateY(-2px); box-shadow: var(--shadow); }
.stat-icon {
  width: 38px; height: 38px; border-radius: 12px;
  display: grid; place-items: center;
  font-size: 1.1rem;
  background: var(--bg-elevated); color: var(--text-muted);
  flex-shrink: 0;
  box-shadow: var(--shadow-xs);
}
.stat-total .stat-icon { color: var(--red); background: var(--red-soft); }
.stat-total .stat-num { color: var(--red); }
.stat-downloaded .stat-icon { color: var(--green); background: rgba(16,185,129,.1); }
.stat-downloaded .stat-num { color: var(--green); }
.stat-existing .stat-icon { color: var(--blue); background: rgba(59,130,246,.1); }
.stat-existing .stat-num { color: var(--blue); }
.stat-failed .stat-icon { color: #EF4444; background: rgba(239,68,68,.1); }
.stat-failed .stat-num { color: #EF4444; }
.stat-data { display: flex; flex-direction: column; min-width: 0; }
.stat-num {
  font-family: var(--mono);
  font-size: 1.35rem; font-weight: 700;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}
.stat-lbl {
  font-size: .68rem; font-weight: 700;
  color: var(--text-muted);
  text-transform: uppercase; letter-spacing: .06em;
  margin-top: 3px;
}
.chart-card h3 {
  font-size: .78rem; font-weight: 700;
  text-transform: uppercase; letter-spacing: .06em;
  color: var(--text-muted); margin-bottom: 16px;
  display: flex; align-items: center; gap: 8px;
}
.chart-card h3 i { color: var(--red); }
.export-bar { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 24px; }

.btn {
  border: none; cursor: pointer;
  border-radius: var(--radius-sm);
  font: 600 .86rem var(--font);
  padding: 10px 20px;
  display: inline-flex; align-items: center; gap: 8px;
  text-decoration: none;
  transition: background .15s var(--ease), transform .15s var(--ease), box-shadow .15s var(--ease);
  min-height: 42px;
  touch-action: manipulation;
}
.btn:active { transform: scale(.97); }
.btn.primary {
  background: var(--red); color: #fff;
  box-shadow: 0 2px 8px rgba(230,0,35,.25), inset 0 1px 0 rgba(255,255,255,.15);
}
.btn.primary:hover {
  background: var(--red-hover);
  box-shadow: 0 6px 20px rgba(230,0,35,.35);
  transform: translateY(-1px);
}
.btn.ghost {
  background: var(--bg-elevated); color: var(--text-soft);
  border: 1px solid var(--border);
  box-shadow: var(--shadow-xs);
}
.btn.ghost:hover { background: var(--surface); border-color: var(--border-strong); }
.btn.small { padding: 8px 14px; font-size: .8rem; min-height: 38px; }
.btn i { font-size: 1rem; }

.masonry { columns: 5 240px; column-gap: 18px; }
body[data-density="compact"] .masonry { columns: 6 200px; column-gap: 14px; }
body[data-density="comfortable"] .masonry { columns: 4 280px; column-gap: 22px; }
.pin-card {
  break-inside: avoid;
  margin-bottom: 18px;
  border-radius: var(--radius-lg);
  overflow: hidden;
  position: relative;
  background: var(--surface);
  cursor: zoom-in;
  animation: fadeUp .5s var(--ease) both;
  transition: transform .3s var(--ease), box-shadow .3s var(--ease);
  box-shadow: var(--shadow-xs);
}
body[data-density="compact"] .pin-card { margin-bottom: 14px; border-radius: var(--radius); }
body[data-density="comfortable"] .pin-card { margin-bottom: 22px; }
.pin-card:hover {
  transform: translateY(-6px) scale(1.01);
  box-shadow: var(--shadow-lg);
  z-index: 2;
}
.pin-card.holding { transform: scale(.94) !important; box-shadow: 0 4px 20px rgba(0,0,0,.3) !important; }
.pin-img {
